{
  "name": "voice-document-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test",
    "fixtures": "node scripts/fixtures.mjs",
    "check": "npm run test && npm run build && npm run test:browser",
    "predev": "node scripts/assets.mjs",
    "prebuild": "node scripts/assets.mjs",
    "format": "prettier --write src tests scripts *.ts *.json *.html",
    "format:check": "prettier --check src tests scripts *.ts *.json *.html"
  },
  "dependencies": {
    "lucide-react": "1.67.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "pdf-lib": "1.17.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
